---
import { Icon } from 'astro-icon/components';

const features = [
  {
    icon: 'ph:monitor',
    title: 'Web Development',
    description: 'Modern, responsive, and high-performance web applications using cutting-edge technologies.',
  },
  {
    icon: 'ph:device-mobile',
    title: 'Mobile Apps',
    description: 'Cross-platform mobile applications that deliver native-like experiences on any device.',
  },
  {
    icon: 'ph:shield-check',
    title: 'Quality Assurance',
    description: 'Comprehensive testing and quality assurance to ensure your software is reliable and robust.',
  },
  {
    icon: 'ph:palette',
    title: 'UI/UX Design',
    description: 'Intuitive, user-centered interfaces designed to delight users and drive engagement.',
  },
  {
    icon: 'ph:cloud',
    title: 'Cloud & DevOps',
    description: 'Scalable cloud infrastructure and automated pipelines for faster, safer releases.',
  },
  {
    icon: 'ph:wrench',
    title: 'Maintenance & Support',
    description: 'Ongoing monitoring, updates, and support to keep your products running smoothly.',
  },
];
---

<section id="about" class="py-16 sm:py-20 lg:py-28 bg-white dark:bg-bg-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-[2fr_3fr] gap-10 sm:gap-12 lg:gap-16 items-start">
      <div data-aos="fade-up" data-aos-duration="500" class="lg:sticky lg:top-24">
        <span class="inline-flex items-center px-3.5 py-1 rounded-full bg-primary/10 text-primary text-xs sm:text-sm font-semibold uppercase tracking-widest">About B-Open</span>
        <h2 class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-dark dark:text-dark-text leading-tight">
          Turning Ideas into Powerful <span class="text-primary">Digital Products</span>
        </h2>
        <div class="w-20 sm:w-24 h-1.5 bg-primary mt-4 sm:mt-5 rounded-full"></div>
        <p class="mt-4 sm:mt-6 text-base sm:text-lg text-gray-text dark:text-gray-dark leading-relaxed">
          We are a passionate team of developers, designers, and visionaries dedicated to crafting exceptional software experiences. From startups to enterprises, we help businesses transform their ideas into powerful digital products.
        </p>
        <div class="mt-8 grid grid-cols-3 gap-3 sm:gap-4">
          <div class="bg-bg dark:bg-card-dark rounded-xl p-3 sm:p-4 text-center border border-primary/10 dark:border-white/5">
            <div class="w-12 sm:w-14 h-12 sm:h-14 bg-primary/15 rounded-xl flex items-center justify-center mx-auto">
              <Icon name="ph:shield-check" class="w-6 sm:w-7 h-6 sm:h-7 text-dark dark:text-dark-text" />
            </div>
            <div class="text-xs sm:text-sm font-bold text-dark dark:text-dark-text mt-2">Reliable</div>
          </div>
          <div class="bg-bg dark:bg-card-dark rounded-xl p-3 sm:p-4 text-center border border-primary/10 dark:border-white/5">
            <div class="w-12 sm:w-14 h-12 sm:h-14 bg-primary/15 rounded-xl flex items-center justify-center mx-auto">
              <Icon name="ph:lightning" class="w-6 sm:w-7 h-6 sm:h-7 text-dark dark:text-dark-text" />
            </div>
            <div class="text-xs sm:text-sm font-bold text-dark dark:text-dark-text mt-2">Dynamic</div>
          </div>
          <div class="bg-bg dark:bg-card-dark rounded-xl p-3 sm:p-4 text-center border border-primary/10 dark:border-white/5">
            <div class="w-12 sm:w-14 h-12 sm:h-14 bg-primary/15 rounded-xl flex items-center justify-center mx-auto">
              <Icon name="ph:lock" class="w-6 sm:w-7 h-6 sm:h-7 text-dark dark:text-dark-text" />
            </div>
            <div class="text-xs sm:text-sm font-bold text-dark dark:text-dark-text mt-2">Secure</div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
        {features.map((feature, index) => (
          <div
            data-aos="scale-in"
            data-aos-duration="600"
            data-aos-delay={index * 100}
            class="group bg-bg dark:bg-card-dark rounded-2xl p-5 sm:p-6 hover:shadow-lg hover:shadow-primary/10 transition-all border border-primary/10 dark:border-white/5"
          >
            <div class="w-10 sm:w-12 h-10 sm:h-12 bg-primary/10 rounded-xl flex items-center justify-center mb-3 sm:mb-4 group-hover:bg-primary/20 transition-colors">
              <Icon name={feature.icon} class="w-5 sm:w-6 h-5 sm:h-6 text-primary" />
            </div>
            <h3 class="text-base sm:text-lg font-bold text-dark dark:text-dark-text mb-1.5 sm:mb-2">{feature.title}</h3>
            <p class="text-sm sm:text-base text-gray-text dark:text-gray-dark leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
