---
import logo from '../assets/logo v2.svg';
---

<footer class="bg-dark dark:bg-bg-dark text-white py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-2">
        <div class="flex items-center">
          <img src={logo.src} alt="B-Open" class="h-10 w-auto brightness-0 invert" />
        </div>
        <p class="mt-4 text-white/60 dark:text-gray-dark max-w-md leading-relaxed">
          We build digital solutions that drive growth. From web apps to mobile platforms, we transform ideas into powerful software.
        </p>
      </div>

      <div>
        <h4 class="font-semibold text-white dark:text-dark-text mb-4">Quick Links</h4>
        <ul class="space-y-2">
          <li><a href="#hero" class="text-white/60 dark:text-gray-dark hover:text-primary transition-colors">Home</a></li>
          <li><a href="#about" class="text-white/60 dark:text-gray-dark hover:text-primary transition-colors">About</a></li>
          <li><a href="#projects" class="text-white/60 dark:text-gray-dark hover:text-primary transition-colors">Projects</a></li>
          <li><a href="#contact" class="text-white/60 dark:text-gray-dark hover:text-primary transition-colors">Contact</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-white dark:text-dark-text mb-4">Follow Us</h4>
        <ul class="space-y-2">
          <li><a href="#" class="text-white/60 dark:text-gray-dark hover:text-primary transition-colors">GitHub</a></li>
          <li><a href="#" class="text-white/60 dark:text-gray-dark hover:text-primary transition-colors">LinkedIn</a></li>
          <li><a href="#" class="text-white/60 dark:text-gray-dark hover:text-primary transition-colors">Twitter</a></li>
          <li><a href="#" class="text-white/60 dark:text-gray-dark hover:text-primary transition-colors">Instagram</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-white/10 text-center">
      <p class="text-white/40 dark:text-gray-dark/60 text-sm">&copy; {new Date().getFullYear()} B-Open. All rights reserved.</p>
    </div>
  </div>
</footer>