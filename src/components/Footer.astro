---
import logo from '../assets/logo v2.svg';
import { Icon } from 'astro-icon/components';
---

<footer class="relative bg-dark dark:bg-bg-dark text-white py-10 sm:py-12 overflow-hidden">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/40 to-transparent"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-6 lg:gap-8">
      <div class="sm:col-span-2 lg:col-span-2">
        <div class="flex items-center">
          <img src={logo.src} alt="B-Open" loading="lazy" class="h-8 sm:h-10 w-auto brightness-0 invert" />
        </div>
        <p data-i18n="footer.description" class="mt-3 sm:mt-4 text-sm sm:text-base text-white/60 dark:text-gray-dark max-w-md leading-relaxed">
          Creamos soluciones digitales que impulsan el crecimiento. De aplicaciones web a plataformas móviles, transformamos ideas en software poderoso.
        </p>
      </div>

      <div>
        <h4 data-i18n="footer.quicklinks.title" class="font-semibold text-white dark:text-dark-text mb-3 sm:mb-4 text-sm sm:text-base">Enlaces Rápidos</h4>
        <ul class="space-y-2">
          <li><a href="#hero" class="text-white/60 dark:text-gray-dark hover:text-primary transition-colors inline-flex items-center gap-2 py-1 min-h-[36px] sm:min-h-0"><Icon name="ph:house" class="w-4 h-4 shrink-0" /><span data-i18n="nav.home" class="text-sm sm:text-base">Inicio</span></a></li>
          <li><a href="#about" class="text-white/60 dark:text-gray-dark hover:text-primary transition-colors inline-flex items-center gap-2 py-1 min-h-[36px] sm:min-h-0"><Icon name="ph:info" class="w-4 h-4 shrink-0" /><span data-i18n="nav.about" class="text-sm sm:text-base">Nosotros</span></a></li>
          <li><a href="#projects" class="text-white/60 dark:text-gray-dark hover:text-primary transition-colors inline-flex items-center gap-2 py-1 min-h-[36px] sm:min-h-0"><Icon name="ph:folder" class="w-4 h-4 shrink-0" /><span data-i18n="nav.projects" class="text-sm sm:text-base">Proyectos</span></a></li>
          <li><a href="#contact" class="text-white/60 dark:text-gray-dark hover:text-primary transition-colors inline-flex items-center gap-2 py-1 min-h-[36px] sm:min-h-0"><Icon name="ph:envelope" class="w-4 h-4 shrink-0" /><span data-i18n="nav.contact" class="text-sm sm:text-base">Contacto</span></a></li>
        </ul>
      </div>

      <div>
        <h4 data-i18n="footer.followus.title" class="font-semibold text-white dark:text-dark-text mb-3 sm:mb-4 text-sm sm:text-base">Síguenos</h4>
        <ul class="space-y-2">
          <li><a href="https://wa.me/5355028601" target="_blank" rel="noopener" class="text-white/60 dark:text-gray-dark hover:text-primary transition-colors inline-flex items-center gap-2 py-1 min-h-[36px] sm:min-h-0"><Icon name="ph:whatsapp-logo" class="w-4 h-4 shrink-0" /><span class="text-sm sm:text-base">WhatsApp</span></a></li>
          <li><a href="https://mail.google.com/mail/?view=cm&fs=1&to=bopenweb@gmail.com" target="_blank" rel="noopener" class="text-white/60 dark:text-gray-dark hover:text-primary transition-colors inline-flex items-center gap-2 py-1 min-h-[36px] sm:min-h-0"><Icon name="ph:envelope-simple" class="w-4 h-4 shrink-0" /><span class="text-sm sm:text-base">Gmail</span></a></li>
          <li><a href="#" class="text-white/60 dark:text-gray-dark hover:text-primary transition-colors inline-flex items-center gap-2 py-1 min-h-[36px] sm:min-h-0"><Icon name="ph:instagram-logo" class="w-4 h-4 shrink-0" /><span class="text-sm sm:text-base">Instagram</span></a></li>
          <li><a href="#" class="text-white/60 dark:text-gray-dark hover:text-primary transition-colors inline-flex items-center gap-2 py-1 min-h-[36px] sm:min-h-0"><Icon name="ph:facebook-logo" class="w-4 h-4 shrink-0" /><span class="text-sm sm:text-base">Facebook</span></a></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 sm:mt-12 pt-6 sm:pt-8 border-t border-white/10 text-center">
      <p class="text-xs sm:text-sm text-white/40 dark:text-gray-dark/60">&copy; {new Date().getFullYear()} B-Open. <span data-i18n="footer.copyright">Todos los derechos reservados.</span></p>
    </div>
  </div>
</footer>