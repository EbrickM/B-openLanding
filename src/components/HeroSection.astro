---

<section id="hero" class="min-h-[100dvh] flex items-center justify-center relative overflow-hidden pt-14 sm:pt-16">
  <div class="absolute inset-0 opacity-30 sm:opacity-40" style="background-image: url('/fondo-hero.webp'); background-size: cover; background-position: center;"></div>
  <div class="absolute inset-0 backdrop-blur-[1px] sm:backdrop-blur-[2px]"></div>
  <div class="absolute inset-0">
    <div class="absolute top-0 -left-40 w-[300px] sm:w-[500px] h-[300px] sm:h-[500px] bg-primary opacity-20 dark:opacity-10 rounded-full blur-[80px] sm:blur-[120px]"></div>
    <div class="absolute top-1/3 -right-40 w-[300px] sm:w-[600px] h-[300px] sm:h-[600px] bg-secondary opacity-20 dark:opacity-10 rounded-full blur-[80px] sm:blur-[120px]"></div>
    <div class="absolute -bottom-40 left-1/4 w-[250px] sm:w-[400px] h-[250px] sm:h-[400px] bg-primary opacity-15 dark:opacity-10 rounded-full blur-[80px] sm:blur-[120px]"></div>
  </div>
  <div class="absolute bottom-0 left-0 right-0 h-24 sm:h-32 bg-gradient-to-b from-transparent to-white dark:to-bg-dark"></div>
  <div data-aos="fade-up" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 w-full">
      <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-dark dark:text-dark-text leading-tight px-2 sm:px-0">
        We Build <span class="text-primary" style="text-shadow: 1px 1px 0 rgba(26,58,42,0.2), 2px 2px 0 rgba(26,58,42,0.15), 3px 3px 0 rgba(26,58,42,0.1), 4px 4px 0 rgba(26,58,42,0.05);">Digital Solutions</span><br />
        That Drive Growth
      </h1>
      <p class="mt-4 sm:mt-6 text-base sm:text-lg md:text-xl text-gray-text dark:text-gray-dark max-w-2xl mx-auto leading-relaxed px-2 sm:px-4">
        We are a software development company specialized in creating modern, scalable, and high-performance web applications tailored to your business needs.
      </p>
    <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 px-4 sm:px-0">
      <a href="#projects" class="w-full sm:w-auto text-center bg-primary hover:bg-primary-dark text-white px-6 sm:px-8 py-3 sm:py-3.5 rounded-full text-base sm:text-lg font-semibold transition-all hover:shadow-lg hover:shadow-primary/30 min-h-[48px] flex items-center justify-center">
        View Our Work
      </a>
      <a href="#contact" class="w-full sm:w-auto text-center border-2 border-dark text-dark dark:border-dark-text dark:text-dark-text hover:bg-primary hover:text-white hover:border-primary px-6 sm:px-8 py-3 sm:py-3.5 rounded-full text-base sm:text-lg font-semibold transition-all min-h-[48px] flex items-center justify-center">
        Contact Us
      </a>
    </div>
    <div class="mt-10 sm:mt-16 flex flex-wrap items-center justify-center gap-4 sm:gap-8 lg:gap-12 text-gray-text dark:text-gray-dark px-2 sm:px-0">
      <div class="text-center min-w-[80px] sm:min-w-0">
        <div class="text-2xl sm:text-3xl lg:text-4xl font-bold text-primary">50+</div>
        <div class="text-xs sm:text-sm lg:text-base mt-0.5 sm:mt-1">Projects Done</div>
      </div>
      <div class="hidden xs:block w-px h-10 sm:h-12 bg-primary/20"></div>
      <div class="text-center min-w-[80px] sm:min-w-0">
        <div class="text-2xl sm:text-3xl lg:text-4xl font-bold text-primary">30+</div>
        <div class="text-xs sm:text-sm lg:text-base mt-0.5 sm:mt-1">Happy Clients</div>
      </div>
      <div class="hidden xs:block w-px h-10 sm:h-12 bg-primary/20"></div>
      <div class="text-center min-w-[80px] sm:min-w-0">
        <div class="text-2xl sm:text-3xl lg:text-4xl font-bold text-primary">5+</div>
        <div class="text-xs sm:text-sm lg:text-base mt-0.5 sm:mt-1">Years Experience</div>
      </div>
    </div>
  </div>
</section>