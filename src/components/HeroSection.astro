---

<section id="hero" class="min-h-screen flex items-center justify-center relative overflow-hidden pt-16">
  <div class="absolute inset-0 opacity-10" style="background-image: url('/fondo-hero.webp'); background-size: cover; background-position: center;"></div>
  <div class="absolute inset-0 backdrop-blur-[2px]"></div>
  <div class="absolute inset-0">
    <div class="absolute top-0 -left-40 w-[500px] h-[500px] bg-primary opacity-20 dark:opacity-10 rounded-full blur-[120px]"></div>
    <div class="absolute top-1/3 -right-40 w-[600px] h-[600px] bg-secondary opacity-20 dark:opacity-10 rounded-full blur-[120px]"></div>
    <div class="absolute -bottom-40 left-1/4 w-[400px] h-[400px] bg-primary opacity-15 dark:opacity-10 rounded-full blur-[120px]"></div>
  </div>
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-b from-transparent to-white dark:to-bg-dark"></div>
  <div data-aos="fade-up" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-dark dark:text-dark-text leading-tight">
        We Build <span class="text-primary">Digital Solutions</span><br />
        That Drive Growth
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-gray-text dark:text-gray-dark max-w-2xl mx-auto leading-relaxed">
        We are a software development company specialized in creating modern, scalable, and high-performance web applications tailored to your business needs.
      </p>
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#projects" class="bg-primary hover:bg-primary-dark text-white px-8 py-3.5 rounded-full text-lg font-semibold transition-all hover:shadow-lg hover:shadow-primary/30">
        View Our Work
      </a>
      <a href="#contact" class="border-2 border-primary text-primary hover:bg-primary hover:text-white px-8 py-3.5 rounded-full text-lg font-semibold transition-all">
        Contact Us
      </a>
    </div>
    <div class="mt-16 flex items-center justify-center gap-8 sm:gap-12 text-gray-text dark:text-gray-dark">
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-bold text-primary">50+</div>
        <div class="text-sm sm:text-base mt-1">Projects Done</div>
      </div>
      <div class="w-px h-12 bg-primary/20"></div>
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-bold text-primary">30+</div>
        <div class="text-sm sm:text-base mt-1">Happy Clients</div>
      </div>
      <div class="w-px h-12 bg-primary/20"></div>
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-bold text-primary">5+</div>
        <div class="text-sm sm:text-base mt-1">Years Experience</div>
      </div>
    </div>
  </div>
</section>