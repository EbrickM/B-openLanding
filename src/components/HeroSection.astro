---
import { Icon } from 'astro-icon/components';
---

<section id="hero" class="min-h-[100dvh] flex items-center justify-center relative overflow-hidden pt-14 sm:pt-16 pb-12 sm:pb-16">
  <div class="absolute inset-0 opacity-30 sm:opacity-40" style="background-image: url('/fondo-hero.webp'); background-size: cover; background-position: center;"></div>
  <div class="absolute inset-0 backdrop-blur-[1px] sm:backdrop-blur-[2px]"></div>
  <div class="absolute inset-0">
    <div class="absolute top-0 -left-40 w-[300px] sm:w-[500px] h-[300px] sm:h-[500px] bg-primary opacity-20 dark:opacity-25 rounded-full blur-[80px] sm:blur-[120px]"></div>
    <div class="absolute top-1/3 -right-40 w-[300px] sm:w-[600px] h-[300px] sm:h-[600px] bg-secondary opacity-20 dark:opacity-20 rounded-full blur-[80px] sm:blur-[120px]"></div>
    <div class="absolute -bottom-40 left-1/4 w-[250px] sm:w-[400px] h-[250px] sm:h-[400px] bg-primary opacity-15 dark:opacity-15 rounded-full blur-[80px] sm:blur-[120px]"></div>
  </div>
  <div class="absolute bottom-0 left-0 right-0 h-24 sm:h-32 bg-gradient-to-b from-transparent to-white dark:to-bg-dark"></div>
  <div data-aos="fade-up" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 w-full">
      <h1 class="mt-4 sm:mt-6 text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black font-display tracking-tight text-dark dark:text-dark-text leading-tight drop-shadow-sm px-2 sm:px-0">
        <span class="block text-center text-balance"><span data-i18n="hero.title.pre">Creamos</span> <span class="bg-gradient-to-r from-primary via-accent to-secondary bg-clip-text text-transparent" data-i18n="hero.title.highlight">Soluciones Digitales</span></span>
        <span class="block text-center text-balance" data-i18n="hero.title.post">Que Impulsan tu Crecimiento</span>
      </h1>
      <p data-i18n="hero.subtitle" class="mt-4 sm:mt-6 text-base sm:text-lg md:text-xl text-gray-text dark:text-gray-dark max-w-2xl mx-auto leading-relaxed drop-shadow-sm px-2 sm:px-4">
        Somos una empresa de desarrollo de software especializada en crear aplicaciones web modernas, escalables y de alto rendimiento adaptadas a las necesidades de tu negocio.
      </p>
    <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 px-4 sm:px-0">
      <a href="#projects" class="group w-full sm:w-auto text-center bg-gradient-to-r from-primary to-secondary hover:brightness-110 text-white px-6 sm:px-8 py-3 sm:py-3.5 rounded-full text-base sm:text-lg font-semibold transition-all hover:shadow-xl hover:shadow-primary/30 min-h-[48px] flex items-center justify-center gap-2">
        <span data-i18n="hero.cta.primary">Ver Nuestro Trabajo</span>
        <Icon name="ph:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
      </a>
      <a href="#contact" class="w-full sm:w-auto text-center border-2 border-dark/80 text-dark dark:border-dark-text/30 dark:text-dark-text hover:bg-primary hover:text-white hover:border-primary px-6 sm:px-8 py-3 sm:py-3.5 rounded-full text-base sm:text-lg font-semibold transition-all min-h-[48px] flex items-center justify-center">
        <span data-i18n="hero.cta.secondary">Contáctanos</span>
      </a>
    </div>
  </div>
</section>