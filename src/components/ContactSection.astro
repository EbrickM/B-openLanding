---
import { Icon } from 'astro-icon/components';
---

<section id="contact" class="py-16 sm:py-20 lg:py-28 bg-white dark:bg-bg-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-10 lg:gap-12 items-start lg:items-center">
      <div data-aos="fade-up" data-aos-duration="500">
        <span class="inline-flex items-center px-3.5 py-1 rounded-full bg-primary/10 text-primary text-xs sm:text-sm font-semibold uppercase tracking-widest">Contact Us</span>
        <h2 class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-dark dark:text-dark-text px-2 sm:px-0">Get in <span class="text-primary">Touch</span></h2>
        <div class="w-20 sm:w-24 h-1.5 bg-primary mt-4 sm:mt-5 rounded-full"></div>
        <p class="mt-4 sm:mt-6 text-base sm:text-lg text-gray-text dark:text-gray-dark leading-relaxed px-2 sm:px-0">
          Have a project in mind? Let's talk about it. We'd love to hear from you and discuss how we can help bring your ideas to life.
        </p>

        <div class="mt-8 sm:mt-10 space-y-4 sm:space-y-6 flex flex-col items-center px-2 sm:px-0">
          <a href="mailto:bopenweb@gmail.com" class="group w-full max-w-sm flex items-center gap-3 sm:gap-4 no-underline">
            <div class="w-10 sm:w-12 h-10 sm:h-12 bg-primary/10 group-hover:bg-primary/20 rounded-xl flex items-center justify-center shrink-0 transition-colors">
              <Icon name="ph:envelope" class="w-5 sm:w-6 h-5 sm:h-6 text-primary" />
            </div>
            <div class="min-w-0">
              <h4 class="text-sm sm:text-base font-semibold text-dark dark:text-dark-text">Email</h4>
              <p class="text-sm sm:text-base text-gray-text dark:text-gray-dark break-all group-hover:text-primary transition-colors">bopenweb@gmail.com</p>
            </div>
          </a>

          <a href="https://wa.me/5355028601" target="_blank" rel="noopener noreferrer" class="group w-full max-w-sm flex items-center gap-3 sm:gap-4 no-underline">
            <div class="w-10 sm:w-12 h-10 sm:h-12 bg-primary/10 group-hover:bg-primary/20 rounded-xl flex items-center justify-center shrink-0 transition-colors">
              <Icon name="ph:whatsapp-logo" class="w-5 sm:w-6 h-5 sm:h-6 text-primary" />
            </div>
            <div class="min-w-0">
              <h4 class="text-sm sm:text-base font-semibold text-dark dark:text-dark-text">WhatsApp</h4>
              <p class="text-sm sm:text-base text-gray-text dark:text-gray-dark break-all group-hover:text-primary transition-colors">+53 5502 8601</p>
            </div>
          </a>
        </div>
      </div>

      <div data-aos="fade-up" data-aos-duration="500" data-aos-delay="100" class="bg-bg dark:bg-card-dark rounded-2xl p-5 sm:p-6 lg:p-8 border border-primary/10 dark:border-white/5">
        <form id="contact-form" class="space-y-4 sm:space-y-5">
          <input type="hidden" name="botcheck" id="botcheck" />
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
            <div>
              <label for="name" class="block text-sm font-medium text-dark dark:text-dark-text mb-1.5">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-3 sm:px-4 py-2.5 sm:py-3 rounded-xl border border-primary/20 dark:border-white/10 bg-white dark:bg-surface-dark text-sm sm:text-base text-dark dark:text-dark-text placeholder-gray-400 dark:placeholder-gray-dark focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-dark dark:text-dark-text mb-1.5">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-3 sm:px-4 py-2.5 sm:py-3 rounded-xl border border-primary/20 dark:border-white/10 bg-white dark:bg-surface-dark text-sm sm:text-base text-dark dark:text-dark-text placeholder-gray-400 dark:placeholder-gray-dark focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
                placeholder="your@email.com"
              />
            </div>
          </div>
          <div>
            <label for="subject" class="block text-sm font-medium text-dark dark:text-dark-text mb-1.5">Subject</label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              class="w-full px-3 sm:px-4 py-2.5 sm:py-3 rounded-xl border border-primary/20 dark:border-white/10 bg-white dark:bg-surface-dark text-sm sm:text-base text-dark dark:text-dark-text placeholder-gray-400 dark:placeholder-gray-dark focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
              placeholder="Project subject"
            />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-dark dark:text-dark-text mb-1.5">Message</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              class="w-full px-3 sm:px-4 py-2.5 sm:py-3 rounded-xl border border-primary/20 dark:border-white/10 bg-white dark:bg-surface-dark text-sm sm:text-base text-dark dark:text-dark-text placeholder-gray-400 dark:placeholder-gray-dark focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all resize-none"
              placeholder="Tell us about your project..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full bg-primary hover:bg-primary-dark text-white px-6 sm:px-8 py-3 sm:py-3.5 rounded-xl text-base sm:text-lg font-semibold transition-all hover:shadow-lg hover:shadow-primary/30 min-h-[48px] disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Send Message
          </button>
          <div id="form-status" role="status" aria-live="polite" class="hidden text-sm sm:text-base text-center rounded-xl px-4 py-3"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  const submitBtn = form?.querySelector('button[type="submit"]');
  const statusEl = document.getElementById('form-status');
  const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;

  const showStatus = (message, isError = false) => {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove('hidden', 'bg-primary/10', 'text-primary', 'bg-red-50', 'dark:bg-red-500/10', 'text-red-600', 'dark:text-red-400');
    if (isError) {
      statusEl.classList.add('bg-red-50', 'dark:bg-red-500/10', 'text-red-600', 'dark:text-red-400');
    } else {
      statusEl.classList.add('bg-primary/10', 'text-primary');
    }
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!accessKey) {
      showStatus('Form is not configured yet. Please set PUBLIC_WEB3FORMS_ACCESS_KEY in your .env file.', true);
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
    }

    const botcheck = document.getElementById('botcheck');
    const formData = new FormData(form);
    const name = formData.get('name');
    formData.append('access_key', accessKey);
    formData.append('from_name', name || 'Website Visitor');
    formData.append('subject', `New message from ${name}: ${formData.get('subject')}`);

    if (botcheck && botcheck.value) {
      showStatus('Submission failed. Please try again.', true);
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';
      }
      return;
    }

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData,
      });
      const data = await response.json();
      if (data.success) {
        form.reset();
        showStatus('Your message has been sent to bopenweb@gmail.com. We will get back to you soon!');
      } else {
        showStatus(data.message || 'There was an error sending your message. Please try again.', true);
      }
    } catch (err) {
      showStatus('There was an error sending your message. Please try again.', true);
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';
      }
    }
  });
</script>
