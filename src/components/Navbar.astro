---
import logo from '../assets/logo v2.svg';
import { Icon } from 'astro-icon/components';
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/90 dark:bg-surface-dark/90 backdrop-blur-md border-b border-primary/10 dark:border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center">
        <img src={logo.src} alt="B-Open" class="h-12 w-auto" />
      </a>
      <div id="desktop-nav" class="hidden md:flex items-center gap-8 relative">
        <a href="#hero" data-nav class="text-gray-text dark:text-gray-dark hover:text-primary transition-colors font-semibold inline-flex items-center gap-1.5"><Icon name="bi:house-fill" class="w-4 h-4" />Home</a>
        <a href="#about" data-nav class="text-gray-text dark:text-gray-dark hover:text-primary transition-colors font-semibold inline-flex items-center gap-1.5"><Icon name="bi:info-circle-fill" class="w-4 h-4" />About</a>
        <a href="#projects" data-nav class="text-gray-text dark:text-gray-dark hover:text-primary transition-colors font-semibold inline-flex items-center gap-1.5"><Icon name="bi:folder-fill" class="w-4 h-4" />Projects</a>
        <a href="#contact" data-nav class="text-gray-text dark:text-gray-dark hover:text-primary transition-colors font-semibold inline-flex items-center gap-1.5"><Icon name="bi:envelope-fill" class="w-4 h-4" />Contact</a>
        <div id="nav-indicator" class="absolute bottom-0 h-0.5 bg-primary rounded-full transition-all duration-300 ease-out" style="left: 0; width: 0;"></div>
        <button id="theme-toggle" class="p-2 text-gray-text dark:text-gray-dark hover:text-primary transition-colors" aria-label="Toggle theme">
          <Icon name="ph:sun" class="w-5 h-5 hidden dark:block" />
          <Icon name="ph:moon" class="w-5 h-5 block dark:hidden" />
        </button>
        <a href="#contact" class="bg-primary hover:bg-primary-dark text-white px-5 py-2.5 rounded-full transition-colors font-medium">Get in Touch</a>
      </div>
      <div class="flex items-center gap-2 md:hidden">
        <button id="theme-toggle-mobile" class="p-2 text-gray-text dark:text-gray-dark hover:text-primary transition-colors" aria-label="Toggle theme">
          <Icon name="ph:sun" class="w-5 h-5 hidden dark:block" />
          <Icon name="ph:moon" class="w-5 h-5 block dark:hidden" />
        </button>
        <button id="menu-btn" class="p-2 text-gray-text dark:text-gray-dark hover:text-primary transition-colors">
          <Icon name="ph:list" class="w-6 h-6" />
        </button>
      </div>
    </div>
  </div>
  <div id="mobile-menu" class="hidden md:hidden bg-white dark:bg-surface-dark border-t border-primary/10 dark:border-white/10">
    <div class="px-4 py-4 space-y-3">
      <a href="#hero" data-nav class="flex items-center gap-1.5 text-gray-text dark:text-gray-dark hover:text-primary transition-colors font-semibold"><Icon name="bi:house-fill" class="w-4 h-4" />Home</a>
      <a href="#about" data-nav class="flex items-center gap-1.5 text-gray-text dark:text-gray-dark hover:text-primary transition-colors font-semibold"><Icon name="bi:info-circle-fill" class="w-4 h-4" />About</a>
      <a href="#projects" data-nav class="flex items-center gap-1.5 text-gray-text dark:text-gray-dark hover:text-primary transition-colors font-semibold"><Icon name="bi:folder-fill" class="w-4 h-4" />Projects</a>
      <a href="#contact" data-nav class="flex items-center gap-1.5 text-gray-text dark:text-gray-dark hover:text-primary transition-colors font-semibold"><Icon name="bi:envelope-fill" class="w-4 h-4" />Contact</a>
      <a href="#contact" class="block text-center bg-primary hover:bg-primary-dark text-white px-5 py-2.5 rounded-full transition-colors font-medium">Get in Touch</a>
    </div>
  </div>
</nav>

<script>
  const toggleTheme = () => {
    const html = document.documentElement;
    html.classList.toggle('dark');
    localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
  };

  document.querySelectorAll('#theme-toggle, #theme-toggle-mobile').forEach(btn => {
    btn?.addEventListener('click', toggleTheme);
  });

  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  const navLinks = document.querySelectorAll('[data-nav]');
  const sections = [...navLinks].map(link => document.getElementById(link.getAttribute('href')?.slice(1))).filter(Boolean);
  const indicator = document.getElementById('nav-indicator');
  const desktopNav = document.getElementById('desktop-nav');

  const updateIndicator = (id) => {
    const active = [...navLinks].find(link => link.getAttribute('href') === `#${id}`);
    if (active && desktopNav?.contains(active) && indicator) {
      const linkRect = active.getBoundingClientRect();
      const navRect = desktopNav.getBoundingClientRect();
      indicator.style.left = `${linkRect.left - navRect.left}px`;
      indicator.style.width = `${linkRect.width}px`;
    }
    navLinks.forEach(link => {
      link.classList.toggle('text-primary', link.getAttribute('href') === `#${id}`);
    });
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        updateIndicator(entry.target.getAttribute('id'));
      }
    });
  }, { rootMargin: '-40% 0px -55% 0px' });

  sections.forEach(section => observer.observe(section));

  updateIndicator('hero');
</script>